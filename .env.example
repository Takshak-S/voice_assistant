# Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# FREE-BY-DEFAULT CONFIGURATION (No paid API keys required for default setup)
# =============================================================================

# LLM Provider Selection (default: groq - free tier available)
# Options: groq, gemini, openai
LLM_PROVIDER=groq

# Groq API Key (required for default Groq provider)
# Get free key from: https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.1-70b-versatile)
LLM_MODEL=llama-3.1-70b-versatile

# =============================================================================
# OPTIONAL PAID PROVIDERS (Not required for default setup)
# =============================================================================

# Optional: OpenAI Provider
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Optional: Google Gemini Provider
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# WEATHER (Free - uses Open-Meteo, no API key required)
# =============================================================================
# No API key needed for default Open-Meteo weather provider

# =============================================================================
# LOCAL DEVELOPMENT DATABASE (Docker Compose PostgreSQL)
# =============================================================================
# These settings are used for local development with Docker Compose.
# The PostgreSQL service runs in a Docker container named "postgres".
# When the backend runs inside Docker Compose, it connects to the service hostname "postgres".
# When the backend runs on the host machine, it connects to "localhost".

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# PRODUCTION DATABASE (Supabase PostgreSQL)
# =============================================================================
# Set this only for production deployment (e.g., Render + Supabase).
# Do NOT set this for local development.
# Example format:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# DATABASE_URL=

# =============================================================================
# CORS & APPLICATION
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# =============================================================================
# Frontend Environment Variables
# Copy this to frontend/.env.local
# =============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000